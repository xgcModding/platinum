+    glFlush();
+    frame.sequence = ++sPublishedSequence;
+    pthread_mutex_unlock(&sPresentationMutex);
+    glBindFramebuffer(GL_FRAMEBUFFER, sPresentationFramebufferId);
+    return true;
+}
