+static int DesiredSwapInterval(u32 vsyncEnabled, u32 frameRateMode) {
+#ifdef SDK_BUILD_OSX
+  return 0;
+#else
+  return frameRateMode == SIM_CONFIG_FRAME_RATE_INF ? 0 : vsyncEnabled;
+#endif
