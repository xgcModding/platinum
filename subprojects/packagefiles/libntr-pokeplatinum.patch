+static s64 ClipDistance(const G3SIM_FxVtx_t &vertex, int plane)
+{
+    return (s64)vertex.w + ((plane & 1) ? -(s64)vertex.nums[plane / 2]
+                                                        : (s64)vertex.nums[plane / 2]);
+}
+
+void G3SIM_SubmitPolygon(G3SIM_FxVtx_t *vertices, int count)
+{
+    SIM_assert(count == 3 || count == 4);
+    if (count < 3 || count > 4) {
+        return;
+    }
+    unsigned anyOutside = 0, allOutside = 0x3f;
+    for (int i = 0; i < count; i++) {
+        unsigned outside = 0;
+        for (int plane = 0; plane < 6; plane++) {
+            if (ClipDistance(vertices[i], plane) < 0) {
+                outside |= 1u << plane;
+            }
+        }
+        anyOutside |= outside;
+        allOutside &= outside;
+    }
+    if (allOutside) {
+        return;
+    }
+    if (!anyOutside) {
+        SubmitClippedPolygon(vertices, count);
+        return;
+    }
+
+    // Clip in homogeneous coordinates before division by W. Masking negative
+    // W into 24 bits projects terrain behind the camera over the visible map.
+    // Work on copies: triangle/quad strips reuse the original input vertices.
+    G3SIM_FxVtx_t buffers[2][16];
+    memcpy(buffers[0], vertices, count * sizeof(*vertices));
+    int source = 0;
+    for (int plane = 0; plane < 6 && count >= 3; plane++) {
+        auto *input = buffers[source];
+        auto *output = buffers[1 - source];
+        int outputCount = 0;
+        for (int i = 0; i < count; i++) {
+            const auto &a = input[(i + count - 1) % count];
+            const auto &b = input[i];
+            s64 da = ClipDistance(a, plane), db = ClipDistance(b, plane);
+            if ((da < 0) != (db < 0)) {
+                double t = (double)da / (double)(da - db);
+                auto &v = output[outputCount++];
+                for (int axis = 0; axis < 4; axis++) {
+                    v.nums[axis] = (fx32)(a.nums[axis] + ((double)b.nums[axis] - a.nums[axis]) * t);
+                }
+                v.nums[plane / 2] = (plane & 1) ? v.w : -v.w;
+                v.s = a.s + (b.s - a.s) * t;
+                v.t = a.t + (b.t - a.t) * t;
+                v.r = a.r + (b.r - a.r) * t;
+                v.g = a.g + (b.g - a.g) * t;
+                v.b = a.b + (b.b - a.b) * t;
+                v.a = a.a + (b.a - a.a) * t;
+            }
+            if (db >= 0) {
+                output[outputCount++] = b;
+            }
+        }
+        count = outputCount;
+        source = 1 - source;
+    }
+    for (int i = 1; i + 1 < count; i++) {
+        G3SIM_FxVtx_t triangle[] = { buffers[source][0], buffers[source][i], buffers[source][i + 1] };
+        SubmitClippedPolygon(triangle, 3);
+    }
+}
