+static void UpdateMonitorRefreshRate(u32 monitor) {
+  SDL_DisplayMode mode;
+  u32 refreshRate = 60;
+#ifdef SDK_BUILD_OSX
+  // On ProMotion, SDL_GetCurrentDisplayMode can expose the instantaneous
+  // adaptive rate (for example 40 Hz) instead of the panel's 120 Hz maximum.
+  // AUTO means the maximum refresh supported by the selected display.
+  const int modeCount = SDL_GetNumDisplayModes(monitor - 1);
+  for (int modeIndex = 0; modeIndex < modeCount; modeIndex++) {
+    if (SDL_GetDisplayMode(monitor - 1, modeIndex, &mode) == 0
+        && mode.refresh_rate >= 30 && mode.refresh_rate <= 240
+        && (u32)mode.refresh_rate > refreshRate) {
+      refreshRate = mode.refresh_rate;
+    }
+  }
+#else
+  if (SDL_GetCurrentDisplayMode(monitor - 1, &mode) == 0
+      && mode.refresh_rate >= 30 && mode.refresh_rate <= 240) {
+    refreshRate = mode.refresh_rate;
+  }
+#endif
+
+  sMonitorRefreshRate.store(refreshRate);
+}
