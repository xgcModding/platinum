+    while (!sPresentationStop.load()) {
+        u32 mode = sDisplayMode.load(), vsync = sDisplayVsync.load();
+        u32 refresh = sMonitorRefreshRate.load();
+        if (refresh < 30 || refresh > 240) refresh = 60;
+        bool unlimited = mode == SIM_CONFIG_FRAME_RATE_INF;
+        bool useVsync = vsync && !unlimited;
+        u32 rate = mode == SIM_CONFIG_FRAME_RATE_30 ? 30
+            : mode == SIM_CONFIG_FRAME_RATE_AUTO ? refresh : 60;
+        u64 interval = unlimited ? 0 : 1000000000ULL / rate;
+        if (mode != previousMode || vsync != previousVsync || refresh != previousRefresh) {
+            if (SDL_GL_SetSwapInterval(useVsync ? 1 : 0) != 0) {
+                fprintf(stderr, "[display] Swap interval failed: %s\n", SDL_GetError());
+            }
+            previousMode = mode; previousVsync = vsync; previousRefresh = refresh;
+            deadline = PresentationTime();
