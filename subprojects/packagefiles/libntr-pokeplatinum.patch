+
+// HBlank DMA transfers one entry per scanline, with the destination reloaded.
+// Keep host pointers intact; the DS DMA register layout holds 32-bit addresses.
+typedef struct {
+    const u8 *source;
+    void *destination;
+    u32 size;
+} SIMHBlankDMA;
+static SIMHBlankDMA sHBlankDMA[4];
+
+void MIi_SIM_StopHBlankDMA(u32 dmaNo)
+{
+    if (dmaNo < 4) sHBlankDMA[dmaNo].size = 0;
+}
+
+void MIi_SIM_RunHBlankDMA(u32 line)
+{
+    for (u32 channel = 0; channel < 4; ++channel) {
+        SIMHBlankDMA *dma = &sHBlankDMA[channel];
+        if (dma->size == 0) continue;
+        const u8 *src = dma->source + line * dma->size;
+        BOOL offsetRegister = FALSE;
+        // The port stores the packed and halfword scroll registers separately.
+        // Rasterizers read the packed register, while DMA callers address HOFS.
+#define SYNC_OFFSET(prefix, bg) \
+        if (dma->destination == (void *)&s_reg_##prefix##bg##HOFS) { \
+            offsetRegister = TRUE; \
+            u32 value = 0; \
+            memcpy(&value, src, dma->size < 4 ? dma->size : 4); \
+            s_reg_##prefix##bg##OFS = dma->size >= 4 ? value \
+                : (s_reg_##prefix##bg##OFS & 0xffff0000u) | (value & 0xffff); \
+        }
+        SYNC_OFFSET(G2_, BG0)
+        SYNC_OFFSET(G2_, BG1)
+        SYNC_OFFSET(G2_, BG2)
+        SYNC_OFFSET(G2_, BG3)
+        SYNC_OFFSET(G2S_DB_, BG0)
+        SYNC_OFFSET(G2S_DB_, BG1)
+        SYNC_OFFSET(G2S_DB_, BG2)
+        SYNC_OFFSET(G2S_DB_, BG3)
+#undef SYNC_OFFSET
+        if (!offsetRegister) memcpy(dma->destination, src, dma->size);
+    }
+}
