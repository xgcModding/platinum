+        || aEvent->type == SDL_JOYAXISMOTION || aEvent->type == SDL_JOYHATMOTION
+        || aEvent->type == SDL_MOUSEBUTTONDOWN || aEvent->type == SDL_MOUSEBUTTONUP;
+    return inputEvent && (s_showWindowPad
+        || igGetIO_ContextPtr(SIM_GUI_ig_context)->WantCaptureKeyboard
