+static bool IsTriggerAxis(SDL_JoystickID instance, int axis)
+{
+    for (int i = 0; i < SDL_NumJoysticks(); i++) {
+        if (SDL_JoystickGetDeviceInstanceID(i) != instance || !SDL_IsGameController(i)) {
+            continue;
         }
+        SDL_GameController *controller = SDL_GameControllerOpen(i);
+        if (controller == NULL) {
+            return false;
+        }
+        SDL_GameControllerButtonBind left = SDL_GameControllerGetBindForAxis(controller, SDL_CONTROLLER_AXIS_TRIGGERLEFT);
+        SDL_GameControllerButtonBind right = SDL_GameControllerGetBindForAxis(controller, SDL_CONTROLLER_AXIS_TRIGGERRIGHT);
+        bool matches = (left.bindType == SDL_CONTROLLER_BINDTYPE_AXIS && left.value.axis == axis)
+            || (right.bindType == SDL_CONTROLLER_BINDTYPE_AXIS && right.value.axis == axis);
+        SDL_GameControllerClose(controller);
+        return matches;
     }
+    // Generic SDL joysticks use axes 0-3 for their two directional sticks.
+    return axis == 4 || axis == 5;
 }
 
