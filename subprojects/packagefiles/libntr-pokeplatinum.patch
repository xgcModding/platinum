+    emitted *= mix(vec3(1.0), phosphor * slot, detail);
+    emitted = emitted * 1.12 + glow * 0.10;
+    vec2 edge = uv * (1.0 - uv);
+    emitted *= 0.94 + 0.06 * pow(16.0 * edge.x * edge.y, 0.25);
