+    glow += linearSample(uv - vec2(1.2, 0.0) / nativeSize);
+    glow += linearSample(uv + vec2(0.0, 1.0) / nativeSize);
+    glow += linearSample(uv - vec2(0.0, 1.0) / nativeSize);
