+static u32 MapPadButtons(int key, bool joystick) {
+  const auto &pad = s_SIM_config.padSettings;
+  const struct { int keyboard; int joystick; u32 button; } bindings[] = {
+    { pad.aKey, pad.aJoyKey, PAD_BUTTON_A },
+    { pad.bKey, pad.bJoyKey, PAD_BUTTON_B },
+    { pad.xKey, pad.xJoyKey, PAD_BUTTON_X },
+    { pad.yKey, pad.yJoyKey, PAD_BUTTON_Y },
+    { pad.upKey, pad.upJoyKey, PAD_KEY_UP },
+    { pad.downKey, pad.downJoyKey, PAD_KEY_DOWN },
+    { pad.leftKey, pad.leftJoyKey, PAD_KEY_LEFT },
+    { pad.rightKey, pad.rightJoyKey, PAD_KEY_RIGHT },
+    { pad.lKey, pad.lJoyKey, PAD_BUTTON_L },
+    { pad.rKey, pad.rJoyKey, PAD_BUTTON_R },
+    { pad.l2Key, pad.l2JoyKey, PAD_BUTTON_L2 },
+    { pad.r2Key, pad.r2JoyKey, PAD_BUTTON_R2 },
+    { pad.l3Key, pad.l3JoyKey, PAD_BUTTON_L3 },
+    { pad.r3Key, pad.r3JoyKey, PAD_BUTTON_R3 },
+    { pad.l4Key, pad.l4JoyKey, PAD_BUTTON_L4 },
+    { pad.r4Key, pad.r4JoyKey, PAD_BUTTON_R4 },
+    { pad.l4Key, pad.l4JoyKey, PAD_BUTTON_L4 },
+    { pad.r4Key, pad.r4JoyKey, PAD_BUTTON_R4 },
+    { pad.startKey, pad.startJoyKey, PAD_BUTTON_START },
+    { pad.selectKey, pad.selectJoyKey, PAD_BUTTON_SELECT },
+  };
+  u32 buttons = 0;
+  for (const auto &binding : bindings) {
+    if (key == (joystick ? binding.joystick : binding.keyboard)) {
+      buttons |= binding.button;
+    }
+  }
+  return buttons;
+}
+
+static void PublishPadButtons() {
+  u32 held = sKeyboardButtons | sJoystickButtons | sLeftStickButtons;
+  u32 pressed = held & ~sPublishedButtons;
+  sPublishedButtons = held;
+  // Preserve every down edge until PAD_Read, even if key-up is in this batch.
+  __atomic_fetch_or(&s_reg_PAD_PRESSED, pressed & 0x0fff, __ATOMIC_RELEASE);
+  __atomic_fetch_or(&s_reg_PAD_EXTRA_PRESSED, pressed & PAD_EXTRA_BUTTON_MASK, __ATOMIC_RELEASE);
+  s_reg_PAD_KEYINPUT = (~held) & 0x03ff;
+  *(vu16 *)HW_BUTTON_XY_BUF = (*(vu16 *)HW_BUTTON_XY_BUF & ~0x0c00) | ((~held) & 0x0c00);
+  __atomic_store_n(&s_reg_PAD_EXTRA_KEYINPUT, (~held) & PAD_EXTRA_BUTTON_MASK, __ATOMIC_RELEASE);
+}
+
+// Convert the complete stick vector to one direction. Independent axis
+// thresholds emit diagonals, leaving direction priority to the game.
+static bool HandleLeftStickAxis(int axis, int value) {
+  if (axis == sLeftStickAxes[0]) sLeftStickValues[0] = value;
+  else if (axis == sLeftStickAxes[1]) sLeftStickValues[1] = value;
+  else return false;
+
+  int x = sLeftStickValues[0], y = sLeftStickValues[1];
+  int absX = abs(x), absY = abs(y);
+  bool wasHorizontal = (sLeftStickButtons & (PAD_KEY_LEFT | PAD_KEY_RIGHT)) != 0;
+  sLeftStickButtons = 0;
+  const int deadzone = s_SIM_config.padSettings.joyAxisDeadzone;
+  if (absX > deadzone || absY > deadzone) {
+    // At exactly 45 degrees keep the current axis instead of chattering.
+    if (absX > absY || (absX == absY && wasHorizontal))
+      sLeftStickButtons = x < 0 ? PAD_KEY_LEFT : PAD_KEY_RIGHT;
+    else
+      sLeftStickButtons = y < 0 ? PAD_KEY_UP : PAD_KEY_DOWN;
+  }
+  PublishPadButtons();
+  return true;
+}
+
+static void RefreshKeyboardButtons() {
+  sKeyboardButtons = 0;
+  for (const auto &press : sKeyboardPresses) {
+    sKeyboardButtons |= press.buttons;
+  }
+  PublishPadButtons();
+}
+
+static void ResetKeyboard() {
+  memset(sKeyboardPresses, 0, sizeof(sKeyboardPresses));
+  RefreshKeyboardButtons();
+  __atomic_store_n(&s_reg_PAD_PRESSED, 0, __ATOMIC_RELEASE);
+  __atomic_store_n(&s_reg_PAD_EXTRA_PRESSED, 0, __ATOMIC_RELEASE);
+}
+
+static void HandleKeyboardEvent(const SDL_KeyboardEvent &event) {
+  int scan = event.keysym.scancode;
+  if (scan <= SDL_SCANCODE_UNKNOWN || scan >= SDL_NUM_SCANCODES) return;
+  KeyboardPress &press = sKeyboardPresses[scan];
+  if (event.type == SDL_KEYUP) {
+    // Release the original binding even if modifiers, layout or config changed.
+    press = {};
+    RefreshKeyboardButtons();
+    return;
+  }
+  if (press.down) {
+    if (press.notifyMods && !SIM_GUI_IsKeyboardCaptured() && Mods_NotifyKeyDown != NULL) {
+      Mods_NotifyKeyDown(press.key, 1);
+    }
+    return;
+  }
+  press.down = true;
+  if (event.repeat) return; // Ignore a key held before the window regained focus.
+  press.key = event.keysym.sym;
+#ifdef SDK_BUILD_OSX
+  press.key = SIM_ResolveKeyboardKey(&event.keysym);
+#endif
+  if (press.key == SDLK_UNKNOWN || SIM_GUI_IsKeyboardCaptured()) return;
+  if (SIM_CRT::HandleKey(press.key, 0, true, &s_SIM_config)) return;
+  if (GameShortcuts_NotifyKeyDown != NULL) {
+    GameShortcuts_NotifyKeyDown(press.key, 0);
+  }
+  if (Mods_NotifyKeyDown != NULL) {
+    press.notifyMods = true;
+    Mods_NotifyKeyDown(press.key, 0);
+  }
+  press.buttons = MapPadButtons(press.key, false);
+  RefreshKeyboardButtons();
+}
