+    }
+    if (!sPresentationRunning.load()) {
+        StopPresentationWorker();
+        SDL_GL_MakeCurrent(window, context);
+        SDL_DestroyWindow(sRenderWindow); sRenderWindow = nullptr;
+        SDL_GL_SetSwapInterval(DesiredSwapInterval(s_SIM_config.vsyncEnabled, s_SIM_config.frameRateMode));
