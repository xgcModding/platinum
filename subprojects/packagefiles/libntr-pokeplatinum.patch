+            if (useVsync) {
+                u64 refreshInterval = 1000000000ULL / refresh;
+                submitAt = deadline > refreshInterval ? deadline - refreshInterval : 0;
+            }
+            u64 now = PresentationTime();
+            while (now < submitAt && !sPresentationStop.load()) {
+                u64 ms = (submitAt - now) / 1000000ULL;
+                if (ms > 1) SDL_Delay((u32)ms - 1);
+                now = PresentationTime();
+            }
+        }
+        if (sPresentationStop.load()) break;
+        pthread_mutex_lock(&sPresentationMutex);
+        int newest = sDisplayedSlot;
+        for (int i = 0; i < 3; i++) {
+            PresentationSlot &candidate = sPresentationSlots[i];
+            if (i == sDisplayedSlot || candidate.sequence == 0
+                || (newest >= 0 && candidate.sequence <= sPresentationSlots[newest].sequence)) continue;
