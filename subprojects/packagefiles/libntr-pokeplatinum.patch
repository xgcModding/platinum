+    if ((disp & (1 << 14)) &&
+        WindowContains(isSub ? s_reg_G2S_DB_WIN1H : s_reg_G2_WIN1H, x) &&
+        WindowContains(isSub ? s_reg_G2S_DB_WIN1V : s_reg_G2_WIN1V, y))
