+    static std::vector<u8> joined;
+    joined.resize(size);
+    for (u32 consumed = 0; consumed < size;) {
+        u32 count = HW_VRAM_A_SIZE - ((offset + consumed) % HW_VRAM_A_SIZE);
+        if (count > size - consumed) {
+            count = size - consumed;
+        }
+        memcpy(joined.data() + consumed, TextureVramAddress(offset + consumed), count);
+        consumed += count;
+    }
