+    const SIM_config_type *config = SIM_GetConfigPtr();
+    if (aEvent->type == SDL_JOYBUTTONDOWN && aEvent->jbutton.button == config->guiJoyKey) {
+        s_showMenuBar = !s_showMenuBar;
+        if (!IsMenuBarVisible() && !SIM_GUI_State) GUI_PadCancelCapture();
+        return true;
+    }
+    if (aEvent->type == SDL_KEYDOWN && config->padSettings.guiKey != SDLK_UNKNOWN
+        && aEvent->key.keysym.sym == config->padSettings.guiKey) {
+        if (!aEvent->key.repeat) {
+            s_showMenuBar = !s_showMenuBar;
+            if (!IsMenuBarVisible() && !SIM_GUI_State) GUI_PadCancelCapture();
+        }
+        return true;
+    }
+    if (aEvent->type == SDL_KEYUP && config->padSettings.guiKey != SDLK_UNKNOWN && aEvent->key.keysym.sym == config->padSettings.guiKey) {
+        return true;
+    }
+    if (!SIM_GUI_State && !IsMenuBarVisible()) {
