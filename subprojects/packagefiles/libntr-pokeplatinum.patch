+    sPresentationWidth = drawableWidth;
+    sPresentationHeight = drawableHeight;
+  }
+
+  glBindFramebuffer(GL_FRAMEBUFFER, sPresentationFramebufferId);
+  glFramebufferTexture2D(GL_FRAMEBUFFER, GL_COLOR_ATTACHMENT0,
