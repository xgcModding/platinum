+bool SIM_GUI_ProcessEvent(SDL_Event *aEvent)
+{
+    if ((SIM_GUI_State || IsMenuBarVisible()) && s_showWindowPad && GUI_PadProcessEvent(aEvent)) return true;
+    if ((aEvent->type == SDL_KEYDOWN || aEvent->type == SDL_KEYUP)
+        && aEvent->key.keysym.sym == SDLK_TAB) {
+        if (aEvent->type == SDL_KEYDOWN && !aEvent->key.repeat) {
+            SIM_GUI_Toggle();
