+void G2SIM_BeginRaster(void) {
+  ReadRasterRegisters(rasterSaved);
+  const u16 savedCount = s_reg_GX_VCOUNT;
+  const u16 savedStatus = s_reg_GX_DISPSTAT;
+  for (int line = 0; line < 192; ++line) {
+    // HBlank handlers prepare the following visible line. Prime line zero
+    // from line 191, just as the original callbacks' wraparound expects.
+    s_reg_GX_VCOUNT = (line + 191) % 192;
+    s_reg_GX_DISPSTAT = (savedStatus & ~1u) | 2u;
+    if (savedStatus & REG_GX_DISPSTAT_HBI_MASK)
+      OS_IRQTable[OS_IE_H_BLANK - 1]();
+    MIi_SIM_RunHBlankDMA(line);
+    ReadRasterRegisters(rasterLines[line]);
+  }
+  s_reg_GX_VCOUNT = savedCount;
+  s_reg_GX_DISPSTAT = savedStatus;
+  WriteRasterRegisters(rasterSaved);
+  rasterActive = true;
+}
+void G2SIM_ApplyRasterLine(u32 line) {
+  if (rasterActive) WriteRasterRegisters(rasterLines[line]);
+}
+void G2SIM_EndRaster(void) {
+  WriteRasterRegisters(rasterSaved);
+  rasterActive = false;
+}
+static bool WindowContains(u16 bounds, int coordinate) {
+  int start = bounds >> 8, end = bounds & 255;
+  return start <= end ? coordinate >= start && coordinate < end
