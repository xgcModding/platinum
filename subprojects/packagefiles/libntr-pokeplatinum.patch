+void SIM_ApplyPendingDisplaySettings(void) {
+  BOOL changed = FALSE;
+  u32 requestedVsync = sRequestedVsyncEnabled.load();
+  u32 requestedFrameRate = sRequestedFrameRateMode.load();
+  const BOOL vsyncChanged = requestedVsync != 0
+      && requestedVsync - 1 != s_SIM_config.vsyncEnabled;
+  const BOOL frameRateChanged = requestedFrameRate != 0
+      && requestedFrameRate - 1 != s_SIM_config.frameRateMode;
+  if (vsyncChanged || frameRateChanged) {
+    const u32 newVsync = vsyncChanged
+        ? requestedVsync - 1 : s_SIM_config.vsyncEnabled;
+    const u32 newFrameRate = frameRateChanged
+        ? requestedFrameRate - 1 : s_SIM_config.frameRateMode;
+    if (
+#if defined(SDK_BUILD_LINUX) && !defined(SDK_BUILD_OSX) && !defined(SDK_BUILD_WIN64)
+        sPresentationRunning.load() ||
+#endif
+        SDL_GL_SetSwapInterval(DesiredSwapInterval(newVsync, newFrameRate)) == 0) {
+      s_SIM_config.vsyncEnabled = newVsync;
+      s_SIM_config.frameRateMode = newFrameRate;
+      s_SIM_nextFrameDeadline = 0;
+      s_SIM_nextPresentDeadline = 0;
+      changed = TRUE;
+    } else {
+      if (vsyncChanged) {
+        sRequestedVsyncEnabled.store(s_SIM_config.vsyncEnabled + 1);
+      }
+      if (frameRateChanged) {
+        sRequestedFrameRateMode.store(s_SIM_config.frameRateMode + 1);
+      }
+    }
+  }
+
+  u32 requestedMonitor = sRequestedMonitor.load();
+  if (requestedMonitor != 0 && requestedMonitor != s_SIM_config.monitor) {
+    BOOL fullscreen = s_SIM_config.windowSizeMode == 5;
+    if (fullscreen) {
+      SDL_SetWindowFullscreen(window, 0);
+    }
+    SDL_SetWindowPosition(window,
+                          SDL_WINDOWPOS_CENTERED_DISPLAY(requestedMonitor - 1),
+                          SDL_WINDOWPOS_CENTERED_DISPLAY(requestedMonitor - 1));
+    if (fullscreen) {
+      SDL_SetWindowFullscreen(window, SDL_WINDOW_FULLSCREEN_DESKTOP);
+    }
+    s_SIM_config.monitor = requestedMonitor;
+    UpdateMonitorRefreshRate(requestedMonitor);
+    s_SIM_nextFrameDeadline = 0;
+    s_SIM_nextPresentDeadline = 0;
+    changed = TRUE;
+  }
+
+  u32 requestedFpsCounter = sRequestedFpsCounterEnabled.load();
+  if (requestedFpsCounter != 0
+      && requestedFpsCounter - 1 != s_SIM_config.showFps) {
+    s_SIM_config.showFps = requestedFpsCounter - 1;
+    changed = TRUE;
+  }
+
+  if (changed) {
+    SIM_Config_SaveGameConfigFile(&s_SIM_config);
+  }
+}
 
