+static bool StartPresentationWorker()
+{
+    static bool attempted;
+    if (attempted) return sPresentationRunning.load();
+    attempted = true;
+    // EGL cannot bind one window surface to two contexts simultaneously.
+    // The producer therefore keeps its original context on a hidden surface.
+    sRenderWindow = SDL_CreateWindow("offscreen renderer", 0, 0, 1, 1, SDL_WINDOW_OPENGL | SDL_WINDOW_HIDDEN);
+    if (!sRenderWindow) return false;
+    SDL_GL_SetAttribute(SDL_GL_SHARE_WITH_CURRENT_CONTEXT, 1);
+    sDisplayContext = SDL_GL_CreateContext(window);
+    SDL_GL_SetAttribute(SDL_GL_SHARE_WITH_CURRENT_CONTEXT, 0);
+    if (!sDisplayContext) {
+        SDL_DestroyWindow(sRenderWindow); sRenderWindow = nullptr;
+        SDL_GL_MakeCurrent(window, context);
+        return false;
+    }
+    SDL_GL_MakeCurrent(window, nullptr);
+    if (SDL_GL_MakeCurrent(sRenderWindow, context) != 0) {
+        SDL_GL_DeleteContext(sDisplayContext); sDisplayContext = nullptr;
+        SDL_DestroyWindow(sRenderWindow); sRenderWindow = nullptr;
+        SDL_GL_MakeCurrent(window, context);
