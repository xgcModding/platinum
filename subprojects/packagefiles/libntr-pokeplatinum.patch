+static bool PublishPresentationFrame()
+{
+    if (!sPresentationRunning.load()) return false;
+    sDisplayMode.store(s_SIM_config.frameRateMode);
+    sDisplayVsync.store(s_SIM_config.vsyncEnabled);
+    pthread_mutex_lock(&sPresentationMutex);
+    int next = -1;
+    for (int i = 0; i < 3; i++) {
+        if (i != sDisplayedSlot && (next < 0 || sPresentationSlots[i].sequence < sPresentationSlots[next].sequence)) next = i;
+    }
+    PresentationSlot &frame = sPresentationSlots[next];
+    if (frame.consumed) {
+        glWaitSync(frame.consumed, 0, GL_TIMEOUT_IGNORED);
+        glDeleteSync(frame.consumed); frame.consumed = nullptr;
+    }
+    if (frame.ready) glDeleteSync(frame.ready);
+    if (!frame.texture) glGenTextures(1, &frame.texture);
+    if (!sPublishFramebuffer) glGenFramebuffers(1, &sPublishFramebuffer);
+    glBindTexture(GL_TEXTURE_2D, frame.texture);
