+// DS 4x4 blocks store sixteen 2-bit texels and a separate palette descriptor.
+void G3SIM_DecodeTexComp4x4(const u8 *texels, const u16 *descriptors,
+    const u16 *palette, u8 *out, u32 width, u32 height)
+{
+    for (u32 by = 0; by < height / 4; ++by) {
+        for (u32 bx = 0; bx < width / 4; ++bx) {
+            u32 block = by * (width / 4) + bx;
+            u16 descriptor = descriptors[block];
+            u32 mode = descriptor >> 14;
+            const u16 *colors = palette + (descriptor & 0x3fff) * 2;
+            for (u32 pixel = 0; pixel < 16; ++pixel) {
+                u32 index = (texels[block * 4 + pixel / 4] >> ((pixel % 4) * 2)) & 3;
+                u8 *dest = out + ((by * 4 + pixel / 4) * width + bx * 4 + pixel % 4) * 4;
+                if (index == 3 && mode < 2) {
+                    memset(dest, 0, 4);
+                    continue;
+                }
+                u16 color = 0;
+                if ((mode & 1) && index >= 2) {
+                    u32 weight = mode == 1 ? 4 : (index == 2 ? 5 : 3);
+                    for (u32 channel = 0; channel < 3; ++channel) {
+                        u32 a = (colors[0] >> (channel * 5)) & 31;
+                        u32 b = (colors[1] >> (channel * 5)) & 31;
+                        color |= ((a * weight + b * (8 - weight)) / 8) << (channel * 5);
+                    }
+                } else {
+                    color = colors[index];
+                }
+                for (u32 channel = 0; channel < 3; ++channel) {
+                    u32 component = (color >> (channel * 5)) & 31;
+                    dest[channel] = (component << 3) | (component >> 2);
+                }
+                dest[3] = 255;
+            }
+        }
+    }
+}
