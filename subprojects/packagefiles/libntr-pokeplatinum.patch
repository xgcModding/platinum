+    for (int y = -1; y <= 1; ++y) {
+        vec2 center = vec2(uv.x, (row + float(y) + 0.5) / nativeSize.y);
+        vec3 signal = linearSample(center) * 0.5;
+        signal += linearSample(center - vec2(0.45 / nativeSize.x, 0.0)) * 0.25;
+        signal += linearSample(center + vec2(0.45 / nativeSize.x, 0.0)) * 0.25;
