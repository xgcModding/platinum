+struct KeyboardPress {
+  bool down;
+  bool notifyMods;
+  SDL_Keycode key;
+  u32 buttons;
+};
+static KeyboardPress sKeyboardPresses[SDL_NUM_SCANCODES] = {};
+static u32 sKeyboardButtons;
