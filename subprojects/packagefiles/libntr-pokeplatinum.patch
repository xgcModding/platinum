+    for (u32 consumed = 0; consumed < size;) {
+        if (TextureVramAddress(offset + consumed) != first + consumed) {
+            contiguous = false;
+            break;
+        }
+        u32 remainingInBank = HW_VRAM_A_SIZE - ((offset + consumed) % HW_VRAM_A_SIZE);
+        consumed += remainingInBank < size - consumed ? remainingInBank : size - consumed;
+    }
+    if (contiguous) {
