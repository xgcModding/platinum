+static int PresentationWorker(void *)
+{
+    if (SDL_GL_MakeCurrent(window, sDisplayContext) != 0) {
+        fprintf(stderr, "[display] Context failed: %s\n", SDL_GetError());
+        sPresentationStop.store(true);
+        return 1;
