+bool GUI_PadProcessEvent(const SDL_Event *event)
+{
+    if (sCaptureTarget == NULL) {
+        return false;
+    }
+    int value;
+    if (event->type == SDL_KEYDOWN && event->key.keysym.sym == SDLK_ESCAPE) {
+        if (event->key.repeat) return true;
+        value = sCaptureJoystick ? SIM_CONFIG_JOY_INVALID_KEY : SDLK_UNKNOWN;
+    } else if (!sCaptureJoystick && event->type == SDL_KEYDOWN && !event->key.repeat) {
+#ifdef SDK_BUILD_OSX
+        value = SIM_ResolveKeyboardKey(&event->key.keysym);
+#else
+        value = event->key.keysym.sym;
+#endif
+    } else if (sCaptureJoystick && event->type == SDL_JOYBUTTONDOWN) {
+        value = event->jbutton.button;
+    } else if (sCaptureJoystick && sCaptureTrigger && event->type == SDL_JOYAXISMOTION
+        && abs(event->jaxis.value) > s_SIM_config.padSettings.joyAxisDeadzone
+        && IsTriggerAxis(event->jaxis.which, event->jaxis.axis)) {
+        value = event->jaxis.axis | (event->jaxis.value > 0
+            ? SIM_CONFIG_JOY_AXIS_PLUS_MASK : SIM_CONFIG_JOY_AXIS_MINUS_MASK);
     } else {
-        sprintf(aBuf, "%d", aButton);
+        return false;
     }
+    ClearBindingConflicts(value);
+    *sCaptureTarget = value;
+    GUI_PadCancelCapture();
+    SIM_Config_SaveGameConfigFile(&s_SIM_config);
+    return true;
 }
 
