+static u64 JoystickShortcutMask(int key) {
+  if (key == SIM_CONFIG_JOY_INVALID_KEY) return 0;
+  const int bindings[] = { s_SIM_config.saveJoyKey, s_SIM_config.resetJoyKey,
+    s_SIM_config.crtToggleJoyKey, s_SIM_config.cameraDistanceIncreaseJoyKey,
+    s_SIM_config.cameraDistanceDecreaseJoyKey };
+  u64 mask = 0;
+  for (unsigned i = 0; i < sizeof(bindings) / sizeof(bindings[0]); i++) {
+    if (bindings[i] == key) mask |= 1ULL << i;
+  }
+  if (key == s_SIM_config.mapJoyKey) mask |= 1ULL << 5;
+  for (int i = 0; i < 25; i++) {
+    if (key == s_SIM_config.poketchJoyKeys[i]) mask |= 1ULL << (6 + i);
+  }
+  if (key == s_SIM_config.undergroundRadarJoyKey) mask |= 1ULL << 31;
+  if (key == s_SIM_config.swapScreensJoyKey) mask |= 1ULL << 32;
+  if (key == s_SIM_config.bicycleJoyKey) mask |= 1ULL << 33;
+  if (key == s_SIM_config.fishingJoyKey) mask |= 1ULL << 34;
+  if (key == s_SIM_config.explorerKitJoyKey) mask |= 1ULL << 35;
+  if (key == s_SIM_config.defogJoyKey) mask |= 1ULL << 36;
+  if (key == s_SIM_config.flyJoyKey) mask |= 1ULL << 37;
+  if (key == s_SIM_config.teleportJoyKey) mask |= 1ULL << 38;
+  if (key == s_SIM_config.surfJoyKey) mask |= 1ULL << 39;
+
+  return mask;
+}
