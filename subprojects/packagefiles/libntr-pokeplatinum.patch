+// The compositor changes GL state between frames. Apply the state belonging
+// to this batch at draw time, including for deferred translucent batches.
+static void ApplyPolygonState(const G3SIM_PolygonAttr_t &attr, bool translucent = false)
+{
+    // Accumulate premultiplied RGB and coverage separately. Squaring the
+    // source alpha loses coverage when the 2D compositor blends BG0 later.
+    glEnable(GL_BLEND);
+    glBlendEquationSeparate(GL_FUNC_ADD, GL_FUNC_ADD);
+    glBlendFuncSeparate(GL_SRC_ALPHA, GL_ONE_MINUS_SRC_ALPHA,
+        GL_ONE, GL_ONE_MINUS_SRC_ALPHA);
+    // Transparent particles must not occlude later particles unless requested
+    // by the polygon. Opaque draws and framebuffer clears still write depth.
+    glDepthMask(!translucent || attr.translucentDepth ? GL_TRUE : GL_FALSE);
+    glDepthFunc(attr.depthTest ? GL_LEQUAL : GL_LESS);
+    if (attr.cullMode == GX_CULL_NONE) {
+        glDisable(GL_CULL_FACE);
+    } else {
+        glEnable(GL_CULL_FACE);
+        glCullFace(attr.cullMode == GX_CULL_ALL ? GL_FRONT_AND_BACK
+            : attr.cullMode == GX_CULL_FRONT ? GL_BACK : GL_FRONT);
+    }
